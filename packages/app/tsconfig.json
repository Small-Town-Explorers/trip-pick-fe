{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@assets/*": ["./assets/*"],
      "@icons/*": ["./assets/icons/*"],
      "@styles": ["./src/styles/index.ts"],
      "@styles/*": ["./src/styles/*"],
      "@components": ["./src/components/index.ts"],
      "@components/*": ["./src/components/*"]
    },
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
