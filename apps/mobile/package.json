{
  "name": "@trip-pick/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@trip-pick/app": "*",
    "expo": "~57.0.7",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "dev": "expo start --dev-client",
    "dev:usb": "adb reverse tcp:8081 tcp:8081 && set \"REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1\" && expo start --dev-client --lan --android",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:development": "npx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
