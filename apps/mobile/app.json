{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jadest13.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "defaultChannel": "travel", "color": "#155744" }],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "../../packages/app/assets/fonts/native/Pretendard-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "../../packages/app/assets/fonts/native/Pretendard-Medium.otf",
                    "weight": 500
                  },
                  {
                    "path": "../../packages/app/assets/fonts/native/Pretendard-SemiBold.otf",
                    "weight": 600
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "../../packages/app/assets/fonts/native/Pretendard-Regular.otf",
              "../../packages/app/assets/fonts/native/Pretendard-Medium.otf",
              "../../packages/app/assets/fonts/native/Pretendard-SemiBold.otf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "993470bc-0969-4896-ac06-efe90afcd768"
      }
    }
  }
}
