# JavaScript key used by the official Kakao Web Maps SDK inside the native WebView.
EXPO_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=
# Must match a JavaScript SDK domain registered in Kakao Developers.
# Example for local development only: http://localhost:5173
EXPO_PUBLIC_KAKAO_MAP_BASE_URL=

# Backend base URL used by the mobile app.
EXPO_PUBLIC_API_BASE_URL=https://trippick.kro.kr
# Native app key used to initialize the Kakao Android/iOS SDK.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# Public web origin registered in Kakao Developers product link settings.
EXPO_PUBLIC_SHARE_WEB_BASE_URL=https://sodosiro.netlify.app
